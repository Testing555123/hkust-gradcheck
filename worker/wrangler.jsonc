{
  "name": "grad-app",
  "main": "src/worker.py",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "python_workers"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grad-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/docs",
      "/docs/*",
      "/openapi.json"
    ]
  },
  "observability": {
    "enabled": true
  }
}
