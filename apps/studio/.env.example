# 本地实例：Postgres 容器 newone-pg（postgres:16-alpine），只绑 127.0.0.1:55432。
# 刻意用 DATABASE_URL 而非全局 MONGODB_URI —— 后者属已放弃的 Mongo 链路（scripts/sync_to_atlas.py）。
DATABASE_URL=postgresql://postgres:newone@127.0.0.1:55432/newone_studio
# 本地开发用随机值；上公网前必须换掉（Payload 用它签名 admin cookie）
PAYLOAD_SECRET=REPLACE_ME_WITH_32_HEX
