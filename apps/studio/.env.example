# 本地实例：Postgres 容器 newone-pg（postgres:16-alpine），只绑 127.0.0.1:55432。
# 刻意用 DATABASE_URL 而非全局 MONGODB_URI —— 后者属已放弃的 Mongo 链路（scripts/sync_to_atlas.py）。
DATABASE_URL=postgresql://postgres:newone@127.0.0.1:55432/newone_studio
# 本地开发用随机值；上公网前必须换掉（Payload 用它签名 admin cookie）
PAYLOAD_SECRET=REPLACE_ME_WITH_32_HEX

# ---- agent bot（apps/worker）----
# PDF 根目录：目录下按学年分目录（形如 2026-27），文件名为 <CODE>_<Degree>_in_<Program>.pdf
WORKER_PDF_ROOT=unpress_pdf
# PDF 解析是 CPU 密集，并发默认 2；核多可调到 4
WORKER_CONCURRENCY=2
# 单份 PDF 失败重试上限（pg-boss 指数退避）
WORKER_MAX_ATTEMPTS=3
# Python 启动器（Windows 用 py；Linux/macOS 用 python3）
WORKER_PYTHON=py
# 解析后端：pymupdf（快）| mineru_api（表格最准，需 MINERU_API_TOKEN）| mineru_local
WORKER_PARSER=pymupdf
# 队列排空判定的空闲时长（毫秒）
WORKER_IDLE_MS=15000
