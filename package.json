{
  "name": "newone",
  "private": true,
  "version": "0.0.0",
  "description": "毕业要求检查系统：packages/domain 为唯一的领域规则来源，frontend 为消费方",
  "workspaces": [
    "packages/*",
    "apps/*",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm -w frontend run test",
    "test:domain": "npm -w @newone/domain run test",
    "build": "npm -w frontend run build",
    "build:studio": "npm -w @newone/studio run build",
    "gates:selftest": "npm -w @newone/studio run gates:selftest",
    "db:migrate": "npm -w @newone/studio run migrate",
    "db:seed": "npm -w @newone/studio run seed",
    "db:ingest": "npm -w @newone/studio run ingest",
    "db:init": "npm run db:migrate && npm run db:seed && npm run db:ingest",
    "lint": "npm -w frontend run lint",
    "typecheck:domain": "npm -w @newone/domain run typecheck",
    "baseline": "python scripts/baseline_manifest.py gen",
    "baseline:check": "python scripts/baseline_manifest.py check",
    "normalize:check": "python scripts/normalize_source_format.py --check",
    "normalize:apply": "python scripts/normalize_source_format.py --apply",
    "fidelity:check": "python scripts/check_port_fidelity.py",
    "probe:audit": "tsx scripts/probe_domain_audit.ts",
    "data:check": "python scripts/export_static_data.py --check",
    "site:parity": "node scripts/check_site_parity.mjs http://127.0.0.1:3200",
    "verify": "npm run baseline:check && npm run fidelity:check && npm run normalize:check && npm run data:check && npm run typecheck:domain && npm test && npm run build && npm run build:studio"
  }
}
